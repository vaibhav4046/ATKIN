{
  "policyName": "ATKIN Sovereign Airgap & Egress Control",
  "version": "1.0.0",
  "defaultEgressMode": "airgap_strict",
  "allowedLocalHosts": [
    "http://127.0.0.1:11434",
    "http://localhost:11434"
  ],
  "permittedPublicLegalAuthorities": [
    "https://www.legislation.gov.uk",
    "https://caselaw.nationalarchives.gov.uk",
    "https://www.courtlistener.com",
    "https://eur-lex.europa.eu",
    "https://www.indiacode.nic.in"
  ],
  "blockedDestinations": [
    "External Telemetry Endpoints",
    "Unverified Third-Party Model APIs",
    "Cloud Sync Storage (unless user configured)",
    "Tracking & Advertising Networks"
  ],
  "enforcementLayer": "src-tauri/src/commands/network.rs + CSP headers in tauri.conf.json",
  "cprPart31AuditCompliance": true
}
